rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the user belongs to the requested tenant
    function belongsToTenant(tenantId) {
      return isAuthenticated() && request.auth.token.tenantId == tenantId;
    }

    // Multi-tenant data structure
    match /tenants/{tenantId} {
      
      // Allow tenant members to read their tenant metadata
      allow read: if belongsToTenant(tenantId);
      // Only admins should write to tenant metadata (simplified for now)
      allow write: if belongsToTenant(tenantId); 

      // Isolated Subcollections
      match /products/{productId} {
        allow read, write: if belongsToTenant(tenantId);
      }
      
      match /transactions/{transactionId} {
        allow read, write: if belongsToTenant(tenantId);
      }
      
      match /customers/{customerId} {
        allow read, write: if belongsToTenant(tenantId);
      }
      
      match /employees/{employeeId} {
        allow read, write: if belongsToTenant(tenantId);
      }
      
      match /inventory/{itemId} {
        allow read, write: if belongsToTenant(tenantId);
      }
      
      match /settings/{document=**} {
        allow read, write: if belongsToTenant(tenantId);
      }
    }
    
    // Global User Profiles (mapped to tenants)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
